# Local-only sample configuration. Replace password before starting Compose.
BACKEND_HOST=0.0.0.0
BACKEND_PORT=4100
BACKEND_PUBLISH_HOST=127.0.0.1
BACKEND_PUBLISH_PORT=4100
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=4200
FRONTEND_PUBLISH_HOST=127.0.0.1
FRONTEND_PUBLISH_PORT=4200
# Compose internal address; frontend server proxies /health, browser never sees this.
BACKEND_ORIGIN=http://backend:4100
POSTGRES_DB=asset_local
POSTGRES_USER=asset_local
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
POSTGRES_PORT=5432
# S0-002 only: set a URL for YOUR disposable local/test PostgreSQL 17 database.
# Keep empty for skeleton health. Never use a production database here.
DATABASE_URL=
# S0-004: token is supplied by the environment, never committed or printed.
# Self-contained synthetic acceptance: npm run cloudflare:verify.
CLOUDFLARE_CONFIG=collectors/cloudflare/config.synthetic.json
CLOUDFLARE_API_TOKEN=
# S0-003: empty registration leaves ingest disabled; JSON host_uuid -> token via secret environment.
OSQUERY_AGENT_TOKENS=
OSQUERY_RAW_DIRECTORY=var/osquery/raw
OSQUERY_ENVIRONMENT=lab
OSQUERY_COLLECTOR_CONFIG=collectors/osquery/config.example.json
OSQUERY_INGEST_TOKEN=

# S1-001: inventory read remains disabled unless explicitly enabled on loopback.
# OIDC values are nonsecret configuration; set your authorized lab issuer/audience/JWKS.
INVENTORY_READ_ENABLED=
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=
OIDC_ALGORITHM=RS256
