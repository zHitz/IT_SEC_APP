// Generated from backend/db/schema.json; 22 business entities + 2 technical junctions.
Table host {
  "id" "uuid" [pk]
  "source" "text"
  "first_seen_at" "timestamptz"
  "last_seen_at" "timestamptz"
  "observed_at" "timestamptz"
